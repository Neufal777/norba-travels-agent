# ── Meta Model API (the agent's brain) ─────────────────────────────────────────
# Leave MODEL_API_KEY empty to run the offline planner: same tools, same UI, rule-based parsing.
# Any OpenAI-compatible Chat Completions endpoint works (Meta Model API, or Llama open weights on
# Baseten / Fireworks / Modal): set the base URL and model of that provider.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
# minimal | low | medium | high | xhigh | max — empty lets the model choose. Providers without it: leave empty.
MODEL_REASONING_EFFORT=low
# How hard the group-trip coordinator thinks (it weighs every traveller's options against each other).
MODEL_PLANNER_EFFORT=high
# Muse Voice Transcribe, on the same Meta key, for dictation.
VOICE_MODEL_ID=muse-voice-transcribe-1.0

# ── Muse Spark Open (Meta open weights, the agency desk) ──────────────────────
# Served by a partner; Baseten's OpenAI-compatible endpoint by default. Empty key: Muse Spark stands in, and says so.
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL_ID=meta-models/muse-spark-open-1026

# ── Norba API (flights) ───────────────────────────────────────────────────────
# nbr_test_… reaches the airlines' sandboxes, nbr_live_… production. Empty = mock mode (generated offers,
# no request leaves this machine — every keyed Norba request is metered).
NORBA_API_KEY=
NORBA_API_URL=https://api.norba.io
# The whsec_ secret of this app's webhook endpoint (/api/webhooks/norba) in the Norba dashboard: airline schedule
# changes reach the agent through it. Empty: no webhook is accepted.
NORBA_WEBHOOK_SECRET=

# ── This app ─────────────────────────────────────────────────────────────────
# Where the app is reached from outside, for checkout links (group trips, agency desk, MCP). Empty: the request's host.
PUBLIC_URL=
# Bearer token for the MCP endpoint (/api/mcp) that other AI assistants connect to. Empty: open (local only).
MCP_TOKEN=

# ── Limits (a public demo spends money on every model call) ───────────────────
# Meta model calls per UTC day for the whole app; 0 turns the cap off.
MAX_MODEL_CALLS_PER_DAY=1500
# Requests per visitor per hour on each route that reaches a model or Norba (chat, voice, desk, MCP, checkout).
MAX_REQUESTS_PER_VISITOR_PER_HOUR=60
# With a nbr_live_ key, real bookings stay off unless this is true.
ALLOW_PRODUCTION_BOOKINGS=false
