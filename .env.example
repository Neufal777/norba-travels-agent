# ── Meta Model API (the agent's brain) ─────────────────────────────────────────
# Leave MODEL_API_KEY empty to run the offline planner: same tools, same UI, rule-based parsing.
# Any OpenAI-compatible Chat Completions endpoint works (Meta Model API, or Llama open weights on
# Baseten / Fireworks / Modal): set the base URL and model of that provider.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
# minimal | low | medium | high | xhigh | max — empty lets the model choose. Providers without it: leave empty.
MODEL_REASONING_EFFORT=low

# ── Norba API (flights) ───────────────────────────────────────────────────────
# nbr_test_… reaches the airlines' sandboxes, nbr_live_… production. Empty = mock mode (generated offers,
# no request leaves this machine — every keyed Norba request is metered).
NORBA_API_KEY=
NORBA_API_URL=https://api.norba.io
# Where "Continue on Norba Travel" sends the traveller to book.
NORBA_BOOKING_URL=https://booking.norba.io
